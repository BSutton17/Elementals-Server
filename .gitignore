# TypeScript's incremental build cache. Machine-local, and a stale one silently
# makes `npm run build` skip re-checking files that did change.
*.tsbuildinfo
*.log
.env
.DS_Store

# The balance-simulation tool is SOURCE and is tracked. Only its generated
# output is ignored — mixing the two under one rule is what previously kept
# ~3,900 lines of hand-written simulator out of version control.
simulation/runs/
